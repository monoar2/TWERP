{
  "name": "erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP for Mexican businesses: inventory, SAT-compliant accounting, CFDI 4.0 invoicing and AI natural-language queries",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @erp/db run migrate",
    "db:seed": "pnpm --filter @erp/db run seed",
    "dev:api": "pnpm --filter @erp/api run dev",
    "dev:web": "pnpm --filter @erp/web run dev",
    "dev:desktop": "pnpm --filter @erp/desktop run dev",
    "dev:mobile": "pnpm --filter @erp/mobile run start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
