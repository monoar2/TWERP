{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP",
  "version": "0.1.0",
  "identifier": "mx.erp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @erp/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "NEXT_OUTPUT=export pnpm --filter @erp/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "ERP: inventario, CFDI 4.0 y contabilidad electrónica",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
