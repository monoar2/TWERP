{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "description": "ERP HTTP API: inventory, invoicing (CFDI 4.0), accounting, SAT exports and AI queries",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "mcp": "tsx src/cli/mcp-stdio.ts",
    "load:69b": "tsx src/cli/load-69b.ts",
    "audit": "tsx src/cli/audit.ts",
    "eval": "tsx src/cli/eval.ts",
    "user:create": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@erp/db": "workspace:*",
    "@erp/mx": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
