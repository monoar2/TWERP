# Postgres connection for migrations and the API (owner role).
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# Read-only role used ONLY by the AI query feature. Created by migration 0003.
AI_DATABASE_URL=postgres://erp_ai_reader:erp_ai_reader@localhost:5432/erp
# Claude API key for natural-language queries.
ANTHROPIC_API_KEY=
# Model used by the AI query feature.
AI_MODEL=claude-opus-5-5
# Hours between automatic audits (0 disables the schedule).
AUDIT_INTERVAL_HOURS=24
# 32-byte key that encrypts the company's CSD private key and password in the
# database. Generate with: openssl rand -hex 32. Losing it means uploading the CSD again.
ERP_SECRET_KEY=
# Time zone of the place where invoices are issued (CFDI Fecha).
ERP_TIMEZONE=America/Mexico_City
# PAC for stamping CFDIs: sandbox (fake timbre, not valid for SAT) or sw (SW Sapien).
PAC_PROVIDER=sandbox
# SW Sapien: https://services.test.sw.com.mx for tests, https://services.sw.com.mx for production.
SW_URL=https://services.test.sw.com.mx
# Either the account user and password, or a long-lived token from the SW dashboard.
SW_USER=
SW_PASSWORD=
SW_TOKEN=
API_PORT=4000
# Web/desktop/mobile clients
NEXT_PUBLIC_API_URL=http://localhost:4000
