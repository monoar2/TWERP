# Postgres connection for migrations and the API (owner role).
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
# Read-only role used ONLY by the AI query feature. Created by migration 0003.
AI_DATABASE_URL=postgres://erp_ai_reader:erp_ai_reader@localhost:5432/erp
# Claude API key for natural-language queries.
ANTHROPIC_API_KEY=
# Model used by the AI query feature.
AI_MODEL=claude-opus-5-5
# Bearer token clients must send to the API (Authorization: Bearer <token>).
ERP_API_TOKEN=change-me
API_PORT=4000
# Web/desktop/mobile clients
NEXT_PUBLIC_API_URL=http://localhost:4000
